# Docker PostgreSQL 16 Connection
DATABASE_URL="postgresql://accentlab:accentlab_password@localhost:5432/accentlab"

# pgAdmin 4 Web Console (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL="admin@accentlab.local"
PGADMIN_DEFAULT_PASSWORD="admin123"

# Auth.js v5 Secret
AUTH_SECRET="replace-with-your-auth-secret-key"
AUTH_TRUST_HOST="true"

# Optional Seeded SuperAdmin Credentials (defaults to admin@accentlab.ai / Admin@12345)
SUPERADMIN_EMAIL="admin@accentlab.ai"
SUPERADMIN_PASSWORD="Admin@12345"

# Optional Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"
